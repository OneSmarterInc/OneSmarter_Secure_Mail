# Synthetic integration only; does not lift the production startup gate.
APP_ENV=test
PQ_TRANSPORT_REQUIRED=true
PUBLIC_URL=https://portal.example.test
ALLOWED_HOSTS=portal.example.test
CSRF_TRUSTED_ORIGINS=https://portal.example.test
KEY_PROTECTOR=key-service
KEY_SERVICE_URL=https://keys.example.test:8443
KEY_SERVICE_CA=/run/pki/keys-ca.pem
KEY_SERVICE_CERT=/run/pki/workload.pem
KEY_SERVICE_KEY=/run/pki/workload.key
SCAN_PROVIDER=clamav
CLAMAV_TRANSPORT=tls
CLAMAV_HOST=scanner.example.test
CLAMAV_PORT=3311
CLAMAV_CA=/run/pki/scanner-ca.pem
CLAMAV_CERT=/run/pki/scanner-client.pem
CLAMAV_KEY=/run/pki/scanner-client.key
MAIL_PROVIDER=development

# Backend must bind only the protected Unix socket, never TCP with this enabled.
TRUSTED_PROXY_UNIX_SOCKET=true
