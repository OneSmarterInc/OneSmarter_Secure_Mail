# Separate workload ingress. Include in the reviewed nginx http configuration.
# Replace integration.example.test in BOTH server_name and SNI guard.
# Keep the existing staff PQ and recipient ingress policies unchanged.
server {
    listen 443 ssl;
    server_name integration.example.test;
    if ($ssl_server_name != "integration.example.test") { return 421; }
    ssl_certificate /run/pki/integration.crt;
    ssl_certificate_key /run/pki/integration.key;
    ssl_client_certificate /run/pki/integration-client-ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.3;
    ssl_session_tickets off;
    ssl_early_data off;
    client_max_body_size 32k;
    access_log off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Cache-Control no-store always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location = /api/integrations/threads {
        limit_except POST { deny all; }
        proxy_pass http://unix:/run/onesmarter/app.sock:;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie "";
        proxy_buffering off;
        proxy_read_timeout 15s;
        proxy_connect_timeout 5s;
    }
    location / { return 404; }
}
