# Copy to .env in the repository root. Never commit .env.
# Existing process environment takes precedence. Empty secrets are placeholders.
APP_ENV=development
PUBLIC_URL=http://localhost:5173
RECIPIENT_PUBLIC_URL=http://localhost:5173/recipient
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_DEV_TOOLS=false
ENABLE_LEGACY_RECIPIENT_API=false
# Leave empty for direct Django access. Set 127.0.0.1 for the local Vite/nginx proxy.
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_UNIX_SOCKET=false
# Empty uses the existing ignored .runtime/django.secret; do not replace casually.
DJANGO_SECRET_KEY=
# Empty host selects SQLite for native development. Compose supplies its DB host.
POSTGRES_HOST=
POSTGRES_DB=secure_mail
POSTGRES_USER=secure_mail
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379/0
STORAGE_PROVIDER=local
KEY_PROTECTOR=local-development
PQ_TRANSPORT_REQUIRED=false
KEY_SERVICE_URL=
KEY_SERVICE_CA=
KEY_SERVICE_CERT=
KEY_SERVICE_KEY=
KEY_STATUS_URL=
KEY_STATUS_CA=
KEY_STATUS_CERT=
KEY_STATUS_KEY=
KEY_STATUS_REQUIRE_PQ=false
# Never put unseal/recovery/root keys in an environment file.
SCAN_PROVIDER=clamav
CLAMAV_TRANSPORT=tcp
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20
CLAMAV_MAX_SIGNATURE_AGE_HOURS=48
# development captures mail locally. smtp sends real mail when a worker runs.
MAIL_PROVIDER=development
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
DEFAULT_FROM_EMAIL=secure@example.test
# Prefer a private password file; never fill both options. SMTP uses STARTTLS.
EMAIL_HOST_PASSWORD=
EMAIL_HOST_PASSWORD_FILE=
# S3/archive are optional; production region and retention remain undecided.
AWS_REGION=
S3_BUCKET=
AUDIT_BUCKET=
AUDIT_RETENTION_DAYS=0

# Application delivery requires an exact company sender-to-credential mapping.
# Global EMAIL_HOST_* settings alone do not authorize application senders.
SMTP_SENDER_PROFILES_FILE=
SMTP_PASSWORD_NOTIFICATIONS=
SMTP_PASSWORD_STAFF=

SETUP_TOKEN_SHA256=
DEV_INBOX_TOKEN_SHA256=
STAGED_UPLOAD_QUOTA_BYTES=104857600
