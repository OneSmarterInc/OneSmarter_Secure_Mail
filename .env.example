# Used by Docker Compose. Generate a private .env with scripts/init_compose.py.
POSTGRES_PASSWORD=
# Native Python does not automatically read .env; use shell environment variables.
# Production is deliberately blocked. Do not add real documents or credentials here.
# Optional separate synthetic key service; migrate local versions before switching.
# KEY_PROTECTOR=key-service
# KEY_SERVICE_URL=https://keys.example.test:8443
# KEY_SERVICE_CA=/run/pki/ca.pem
# KEY_SERVICE_CERT=/run/pki/workload.pem
# KEY_SERVICE_KEY=/run/pki/workload.key
# Recovery/root secrets must never be placed here.

# Real ClamAV is the default. Native Linux deployment example:
# CLAMAV_TRANSPORT=unix
# CLAMAV_SOCKET=/run/clamav/clamd.ctl
# Scanner must use TZ=UTC for VERSION timestamp interpretation.
# CLAMAV_MAX_SIGNATURE_AGE_HOURS=48
# CLAMAV_TIMEOUT_SECONDS=20
# SCAN_PROVIDER=synthetic is only for explicit synthetic development/tests.
